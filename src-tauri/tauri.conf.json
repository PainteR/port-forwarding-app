{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Forward",
  "version": "0.1.0",
  "identifier": "com.painter.port-forwarding-app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Port Forward",
        "width": 1600,
        "height": 1020,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Native SSH tunnel manager.",
    "longDescription": "Port Forward manages local, remote, dynamic, and Docker-backed SSH port forwards from a desktop UI.",
    "copyright": "Copyright 2026 painter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
